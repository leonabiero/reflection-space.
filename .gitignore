__pycache__/
*.pyc
*.pyo
*.pyd

# Local Python "toolbox" (virtual environment) and test leftovers --
# only for running the tests on a laptop, never pushed.
.venv/
.pytest_cache/

# Never commit local secrets (Streamlit Cloud manages the real ones
# via its own Secrets dashboard -- this is only a guard against
# accidentally committing a local secrets.toml used for testing).
.streamlit/secrets.toml

