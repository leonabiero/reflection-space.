# HOW TO USE THIS FILE
# 1. Make a copy of this file in this same folder, named exactly ".env"
#    (not ".env.example" -- just ".env")
# 2. Fill in the real values below -- the SAME values your main app
#    already uses (Streamlit Cloud -> Settings -> Secrets, or wherever
#    you keep them written down).
# 3. Never share this file or paste its contents anywhere public --
#    it contains real passwords/keys. It's already excluded from
#    GitHub by the .gitignore file in this folder.

# Your real database address (same one the live app uses)
DATABASE_URL=

# Your real Gemini API key (same one the live app uses)
GEMINI_API_KEY=

# Your real Qdrant address, key, and collection name (same ones the live app uses)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=rdi_documents
